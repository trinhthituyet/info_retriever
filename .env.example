# ============================================================================
# Which model answers. Everything else in this file is provider-specific.
#   anthropic -> Claude via Apple's Floodgate gateway (or the public API)
#   vllm      -> a local model behind vLLM's OpenAI-compatible server
# ============================================================================
LLM_PROVIDER=anthropic

# --- LLM_PROVIDER=anthropic --------------------------------------------------
# appleconnect: mint a short-lived OAuth token and go through Floodgate (default).
# default:      let the SDK resolve ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / an
#               `ant auth login` profile, against the public API.
ANTHROPIC_AUTH_MODE=appleconnect

# Only used when ANTHROPIC_AUTH_MODE=default.
ANTHROPIC_API_KEY=

EXTRACT_MODEL=claude-opus-5
AGENT_MODEL=claude-opus-5
# Thinking/token depth for the agent: low | medium | high | xhigh | max
AGENT_EFFORT=medium

# In appleconnect mode the gateway is set by FLOODGATE_BASE_URL, deliberately NOT
# ANTHROPIC_BASE_URL — that variable is often set to a local proxy, and honouring it
# would send an Apple identity token there.
# FLOODGATE_BASE_URL=https://floodgate.g.apple.com/api/anthropic

# appleconnect knobs — defaults match the Floodgate client registration.
# APPLECONNECT_PATH=/usr/local/bin/appleconnect
# APPLECONNECT_APP_ID=hvys3fcwcteqrvw3qzkvtk86viuoqv
# APPLECONNECT_ENV=prod
# APPLECONNECT_SCOPES=openid,dsid,accountname,profile,groups
# APPLECONNECT_TIMEOUT_SECONDS=30
# Fallback lifetime, used only when the token carries no readable `exp` claim.
# APPLECONNECT_TOKEN_TTL_SECONDS=1800

# Floodgate's certificate chains to an Apple-internal root, so the CA bundle comes
# from apple-certifi automatically. Set this only to override it.
# SSL_CERT_FILE=/path/to/cacert.pem

# --- LLM_PROVIDER=vllm -------------------------------------------------------
# Start the server with tool calling and (for scans) a vision-capable model, e.g.
#   vllm serve Qwen/Qwen2.5-VL-7B-Instruct --port 8001 \
#     --enable-auto-tool-choice --tool-call-parser hermes
VLLM_BASE_URL=http://127.0.0.1:8001/v1
# Required. Must match what the server serves — `curl $VLLM_BASE_URL/models` lists it.
VLLM_MODEL=
# vLLM ignores this unless started with --api-key.
VLLM_API_KEY=not-needed
VLLM_MAX_TOKENS=4096
VLLM_TEMPERATURE=0.2
# Resolution for rasterising scanned PDF pages (needs the `vllm` extra).
VLLM_PDF_DPI=150

# --- Query normalisation -----------------------------------------------------
# Documents are assumed to be in English. Before searching, detect the question's
# language, render it in English, and rewrite it into contract vocabulary — several
# English phrasings, fused by RRF. Costs one small model call per question.
# Set to 0/false/off to search verbatim.
QUERY_REWRITE=1

# --- Conversation history ----------------------------------------------------
# How much of a conversation is replayed on each follow-up. Turns carry the
# question, answer and cited sources — never the tool transcript, which would
# exhaust the context window in a few turns. Trimming drops the oldest first.
HISTORY_MAX_TURNS=12
HISTORY_MAX_CHARS=12000

# --- Local embeddings (nothing leaves this machine, either provider) ---------
# BAAI/bge-m3            -> 1024 dim, multilingual, best quality  (~2.2 GB)
# intfloat/multilingual-e5-small -> 384 dim, fast, needs prefixes (~0.5 GB)
# BAAI/bge-small-en-v1.5 -> 384 dim, English only, fastest        (~0.1 GB)
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# Some models require instruction prefixes (e5 family needs these; bge-m3 does not).
EMBED_QUERY_PREFIX=
EMBED_PASSAGE_PREFIX=

# --- Storage ----------------------------------------------------------------
# sqlite   -> sqlite-vec + FTS5 in one file. No server (the default).
# postgres -> pgvector + tsvector. Concurrent writers; needs a running server.
DB_BACKEND=sqlite

# Required when DB_BACKEND=postgres. DATABASE_URL is accepted as a fallback.
# The `vector` extension is created automatically, so the role needs rights to do so
# (or run `create extension vector;` once as a superuser first).
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/ir_test

# SQLite database file and the blob store both live here.
DATA_DIR=./data
