# --- Auth -------------------------------------------------------------------
# appleconnect: mint a short-lived OAuth token and go through Apple's Floodgate
#               gateway (the default).
# default:      let the SDK resolve ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / an
#               `ant auth login` profile, against the public API.
ANTHROPIC_AUTH_MODE=appleconnect

# Only used when ANTHROPIC_AUTH_MODE=default.
ANTHROPIC_API_KEY=

# Defaults to the Floodgate gateway in appleconnect mode, and to the public API in
# default mode. Override to point at another gateway.
# ANTHROPIC_BASE_URL=https://floodgate.g.apple.com/api/anthropic

# appleconnect knobs — the defaults match the Floodgate client registration.
# APPLECONNECT_PATH=/usr/local/bin/appleconnect
# APPLECONNECT_APP_ID=hvys3fcwcteqrvw3qzkvtk86viuoqv
# APPLECONNECT_ENV=prod
# APPLECONNECT_SCOPES=openid,dsid,accountname,profile,groups
# APPLECONNECT_TIMEOUT_SECONDS=30
# Fallback lifetime, used only when the token carries no readable `exp` claim.
# APPLECONNECT_TOKEN_TTL_SECONDS=1800

# --- Models -----------------------------------------------------------------
# Claude model used for OCR/transcription and structured field extraction.
EXTRACT_MODEL=claude-opus-5
# Claude model that drives the retrieval agent loop.
AGENT_MODEL=claude-opus-5
# Thinking/token depth for the agent: low | medium | high | xhigh | max
AGENT_EFFORT=medium

# --- Local embeddings (nothing leaves this machine) --------------------------
# BAAI/bge-m3            -> 1024 dim, multilingual, best quality  (~2.2 GB)
# intfloat/multilingual-e5-small -> 384 dim, fast, needs prefixes (~0.5 GB)
# BAAI/bge-small-en-v1.5 -> 384 dim, English only, fastest        (~0.1 GB)
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# Some models require instruction prefixes (e5 family needs these; bge-m3 does not).
EMBED_QUERY_PREFIX=
EMBED_PASSAGE_PREFIX=

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
